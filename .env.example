# URL base del backend (ORBIT Store API).
# En local: la URL completa del backend corriendo en tu maquina.
# En produccion (Vercel): se deja como ruta relativa "/api" -- vercel.json
# tiene un rewrite que reenvia /api/* al backend real por detras, para que
# el frontend y el backend vivan bajo un solo dominio para quien visita el sitio.
VITE_API_URL=http://localhost:4000/api
